# ---- Vercel website settings (one set per client) ----
# Railway backend address, e.g. https://social-server-production.up.railway.app
SERVER_URL=
# Same long random value as SERVER_API_KEY on Railway.
SERVER_API_KEY=
# The owner's login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random value used to sign login cookies (at least 32 characters).
SESSION_SECRET=
# Name shown at the top of the site.
NEXT_PUBLIC_APP_NAME=Social Autopilot
