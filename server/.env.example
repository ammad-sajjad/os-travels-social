# ---- Railway backend settings (one set per client) ----
# Shared secret: put the SAME long random value in the Vercel website's SERVER_API_KEY.
SERVER_API_KEY=

# Claude (console.anthropic.com -> API keys). Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Model used to write posts (default from the build guide).
CLAUDE_MODEL=claude-sonnet-5-5

# Free stock photos (pexels.com/api). Optional: without it, posts use the brand colour background.
PEXELS_API_KEY=

# Meta (Business Settings -> System users -> Generate token). See README "Meta setup".
META_GRAPH_VERSION=v26.0
META_SYSTEM_USER_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Railway adds DATABASE_URL automatically when you attach a Postgres database.
DATABASE_URL=
# Mount a Railway volume at /data (images and videos are stored there).
DATA_DIR=/data
# Usually not needed on Railway (RAILWAY_PUBLIC_DOMAIN is used). Set if you use a custom domain.
PUBLIC_URL=
TIMEZONE=Asia/Karachi
